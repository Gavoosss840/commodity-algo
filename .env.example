# Copy this file to .env (never commit .env) and fill in the free keys.

# USDA FAS PSD balance sheets (WASDE data). Free key: https://api.data.gov/signup/
# DEMO_KEY works for a first test but is rate-limited.
USDA_FAS_API_KEY=DEMO_KEY

# EIA weekly petroleum data (only for the WTI model, roadmap stage 4). Free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Optional: Open-Meteo is free without a key for NON-commercial use.
# For commercial use, buy a plan and put the key here.
OPEN_METEO_API_KEY=
